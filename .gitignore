# secrets: the model key lives outside the repo (~/.config/jobhunt/anthropic.key); never copy it in
*.key
.env
# local Python env and caches
.venv/
__pycache__/
# generated by seed.py against a specific database
ground_truth.json
# Odoo data lives in Docker named volumes (odoo-db, odoo-data); keep any bind-mounted copies out too
odoo-db/
odoo-data/
# run outputs are scrubbed of passwords and keys by agent.save_run; anything marked secret stays local
runs/*.secret.json
